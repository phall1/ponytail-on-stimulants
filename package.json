{
  "name": "ponytail-on-stimulants",
  "version": "0.2.0",
  "description": "Minimal architecture. Maximal execution. Completion discipline for coding agents.",
  "keywords": ["agent-plugin", "opencode-plugin", "opencode", "coding-agent", "completion", "mcp", "pi-package", "pi", "skills", "qoder"],
  "license": "MIT",
  "author": {
    "name": "phall1",
    "url": "https://github.com/phall1"
  },
  "contributors": [
    {
      "name": "Dietrich Gebert",
      "url": "https://github.com/DietrichGebert"
    }
  ],
  "homepage": "https://github.com/phall1/ponytail-on-stimulants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phall1/ponytail-on-stimulants.git"
  },
  "bugs": {
    "url": "https://github.com/phall1/ponytail-on-stimulants/issues"
  },
  "main": "./.opencode/plugins/ponytail-on-stimulants.mjs",
  "exports": {
    ".": "./.opencode/plugins/ponytail-on-stimulants.mjs",
    "./completion-gate": "./completion-gate/index.js",
    "./completion-gate/jev": "./completion-gate/jev.js"
  },
  "files": [
    "plugin.json",
    "mcp.json",
    "mcp/",
    "AGENTS.md",
    "completion-gate/",
    "hooks/",
    "skills/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    "pi-extension/index.js",
    "scripts/uninstall.js",
    "scripts/cursor-hooks.js",
    "LICENSE",
    "UPSTREAM.md",
    "RELEASE.md"
  ],
  "scripts": {
    "check": "node scripts/check-rule-copies.js && node scripts/check-versions.js",
    "test": "node --test tests/*.test.js && npm test --prefix pi-extension",
    "test:completion": "node --test tests/completion-gate.test.js && node benchmarks/completion/selftest.js && node benchmarks/completion/evaluate.js --selftest"
  },
  "pi": {
    "extensions": ["./pi-extension/index.js"],
    "skills": ["./skills"]
  },
  "publishConfig": {
    "access": "public"
  }
}
