{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/ponytail-on-stimulants-activate.js\" --reset",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\ponytail-on-stimulants-activate.js\" --reset",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/ponytail-on-stimulants-mode-tracker.js\"",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\ponytail-on-stimulants-mode-tracker.js\"",
        "timeoutSec": 5
      }
    ]
  }
}
