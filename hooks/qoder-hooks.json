{
  "_comment": "Loaded live by .qoder-plugin/plugin.json. Hook launchers read QODER_PLUGIN_ROOT from the environment inside Node; never substitute the install path into shell command text.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.QODER_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-on-stimulants-mode-tracker.js'))\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "task|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.QODER_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-on-stimulants-subagent.js'))\""
          }
        ]
      }
    ]
  }
}
